# ==========================================
# Vigil Green GIS - Root GitIgnore Configuration
# ==========================================

# ------------------------------------------
# Environment & Secrets (Bảo mật)
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ------------------------------------------
# Large Binary Files & Docker Export Images (>100MB)
# ------------------------------------------
docker-images/
*.tar.gz
*.tar
*.zip
*.7z

# ------------------------------------------
# Python / Backend Dependencies & Artifacts
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# Backend user uploads (Giữ lại thư mục nhưng bỏ qua file ảnh do người dùng upload)
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------
# Node.js / Frontend Dependencies & Artifacts
# ------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
.swc/
frontend/.swc/
out/
build/
dist/
*.tsbuildinfo

# ------------------------------------------
# Logs & Testing
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
